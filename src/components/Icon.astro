---
/**
 * Инлайн-иконки, выгруженные из макета (Figma → svgAssets), поэтому формы
 * совпадают с дизайном, а не приблизительно повторяют его.
 *
 * Размеры заданы натуральные — те же, что в макете. Цвет наследуется
 * от текста через currentColor.
 *
 * «CV» в макете — не иконка, а жирная текстовая метка, см. Button.astro.
 */
export type IconName = 'telegram' | 'linkedin' | 'arrow-up';

interface Props {
  name: IconName;
  /** Подпись нужна только там, где рядом нет текста; иначе иконка декоративна. */
  label?: string;
}

const { name, label } = Astro.props;

const a11y = label
  ? ({ role: 'img', 'aria-label': label } as const)
  : ({ 'aria-hidden': 'true' } as const);
---

