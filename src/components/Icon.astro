---
/**
 * Иконки из набора в src/icons/ — это ровно те файлы, что выгружены из макета.
 *
 * Чтобы добавить иконку, достаточно положить SVG в src/icons/: имя файла
 * без расширения и есть имя иконки. Правки в этом файле не нужны.
 *
 * Служебные заливки (black/white и нейтральный серый #464646, которым
 * выгружен набор) из файла убираются, чтобы иконка наследовала цвет текста
 * через currentColor: в макете такой иконке цвет назначают на месте —
 * например на плитке метрики она то светлая, то зелёная. Осмысленные
 * цвета — жёлтая звезда, серая искра-маркер — остаются как есть.
 */
const sources = import.meta.glob('../icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const icons = new Map(
  Object.entries(sources).map(([path, source]) => [
    path.slice(path.lastIndexOf('/') + 1, -'.svg'.length),
    source,
  ]),
);

/** Имя файла из src/icons/ без расширения. */
export type IconName = string;

interface Props {
  name: IconName;
  /**
   * Сторона в px. По умолчанию берётся натуральный размер из файла —
   * он же размер иконки в макете.
   */
  size?: number;
  /** Подпись нужна только там, где рядом нет текста; иначе иконка декоративна. */
  label?: string;
}

const { name, size, label } = Astro.props;

const source = icons.get(name);
if (!source) {
  // Ошибка на сборке, а не молчаливо пустая иконка на странице.
  throw new Error(
    `Иконка «${name}» не найдена в src/icons/. Доступны: ${[...icons.keys()].sort().join(', ')}`,
  );
}

const viewBox = source.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 24 24';
const naturalWidth = Number(source.match(/\swidth="(\d+(?:\.\d+)?)"/)?.[1] ?? 24);
const naturalHeight = Number(source.match(/\sheight="(\d+(?:\.\d+)?)"/)?.[1] ?? 24);

/* Явный size задаёт сторону и сохраняет пропорции файла (не все иконки квадратные). */
const scale = size ? size / Math.max(naturalWidth, naturalHeight) : 1;
const width = Math.round(naturalWidth * scale * 100) / 100;
const height = Math.round(naturalHeight * scale * 100) / 100;

const body = source
  .replace(/<svg[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  .replace(/\s*fill="(black|white|#000|#000000|#fff|#ffffff|#464646)"/gi, '')
  .trim();

const a11y = label
  ? ({ role: 'img', 'aria-label': label } as const)
  : ({ 'aria-hidden': 'true' } as const);
---

<svg {...a11y} width={width} height={height} {viewBox} fill="currentColor" focusable="false">
  <Fragment set:html={body} />
</svg>
