---
import Icon from './Icon.astro';
import Term from './Term.astro';

/**
 * Плашка-подсказка в правой колонке кейса: иконка «i», заголовок и пояснение.
 *
 * В макете компонент называется TooltipBlock (узел `4317:7481`), но самого
 * тултипа тут нет — это плашка, которая объясняет, что дальше в тексте
 * подчёркнутые пунктиром термины раскрываются при наведении. Поэтому
 * заголовок набран тем же пунктиром: он показывает приём на себе.
 *
 * Размеры из макета: 614×140 при полях 20/32 и зазоре 8 до текста.
 */
interface Props {
  title: string;
  text: string;
  /**
   * Определение, всплывающее при наведении на заголовок. Заголовок здесь —
   * показательный пример приёма: подсказка объясняет приём и тут же его
   * показывает. Без определения остаётся просто подчёркнутый текст.
   */
  definition?: string;
}

const { title, text, definition } = Astro.props;
---

<div class="note">
  {/* Обёртка нужна, чтобы задать иконке цвет и запретить сжатие:
      scoped-стили не достают до элементов дочернего компонента. */}
  <span class="note__icon">
    <Icon name="information" />
  </span>

  <div class="note__text">
    {/* Пунктир рисует либо Term, либо сам заголовок — но не оба сразу:
        подчёркивание от абзаца всё равно протянулось бы на термин внутри,
        и линии наложились бы. */}
    <p class:list={['note__title', !definition && 'note__title--dotted']}>
      {definition ? <Term definition={definition}>{title}</Term> : title}
    </p>
    <p class="note__body">{text}</p>
  </div>
</div>

<style>
  .note {
    display: flex;
    gap: var(--space-2);
    /* Справа поле шире: в макете 20 слева и 32 справа. */
    padding: 20px var(--space-6) 20px 20px;
    background: var(--surface-note);
    border-radius: var(--radius-card);
  }

  .note__icon {
    display: flex;
    flex-shrink: 0;
    color: var(--icon-note);
  }

  .note__text {
    display: grid;
    gap: var(--space-1); /* 4px между заголовком и пояснением */
  }

  .note__title {
    color: var(--text-primary);
  }

  /* Пунктир — тот же приём, которым дальше в кейсе размечены термины;
     отступ линии от текста — как у них (см. Term.astro). */
  .note__title--dotted {
    text-decoration: underline dotted;
    text-decoration-thickness: 10%;
    text-underline-offset: 3px;
  }

  .note__body {
    color: var(--text-secondary);
  }
</style>
