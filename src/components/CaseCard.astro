---
import Badge from './Badge.astro';
import DesktopShot from './DesktopShot.astro';
import PhoneShots from './PhoneShots.astro';
import type { CollectionEntry } from 'astro:content';

/**
 * Карточка кейса на главной: заголовок, плашки с метриками и серый контейнер
 * с экранами приложения.
 *
 * Контейнер с экранами вынесен в PhoneShots — в макете это тот же узел,
 * что и в первом экране страницы кейса. У кейса про веб экран один
 * и десктопный, поэтому там стоит DesktopShot — тоже общий с первым
 * экраном кейса.
 *
 * Карточка становится ссылкой только у кейса с описанными разделами: у кейса
 * без них страница не собирается, и ссылка вела бы в 404. Заодно заготовка
 * не обещает клик — ни курсором, ни ховером.
 */
interface Props {
  entry: CollectionEntry<'cases'>;
}

const { entry } = Astro.props;
const { title, metrics, tags, shots, cover, sections } = entry.data;

const href = sections.length > 0 ? `/cases/${entry.id}/` : undefined;
/* Astro подставляет имя тега из переменной с заглавной буквы. */
const Wrapper = href ? 'a' : 'div';
---

<article class="case">
  <Wrapper class="case__inner" href={href}>
    <div class="case__head">
      <h3 class="case__title">{title}</h3>

      {
        (metrics.length > 0 || tags.length > 0) && (
          <div class="case__badges">
            {metrics.map((metric) => (
              <Badge variant="success" label={`${metric.value} ${metric.label}`} />
            ))}
            {tags.map((tag) => (
              <Badge variant="neutral" label={tag} />
            ))}
          </div>
        )
      }
    </div>

    {
      cover ? (
        <DesktopShot shot={cover} interactive={Boolean(href)} />
      ) : (
        shots.length > 0 && <PhoneShots shots={shots} interactive={Boolean(href)} />
      )
    }
  </Wrapper>
</article>

<style>
  .case__head {
    margin-bottom: var(--space-6); /* 32px до серого контейнера */
  }

  .case__title {
    max-width: 888px;
    margin-bottom: var(--space-5); /* 24px до плашек */
  }

  .case__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--column-gap);
  }

  /*
   * Карточка занимает 85% высоты окна — требование владельца; в макете
   * высота фиксированная (шапка плюс контейнер 1240×821). Шапка держит
   * свою высоту, обложка забирает весь остаток: она — единственный
   * тянущийся элемент колонки.
   *
   * Ссылкой становится вся карточка, поэтому обводка фокуса обводит её
   * целиком — иначе с клавиатуры непонятно, что именно выбрано.
   */
  .case__inner {
    display: flex;
    flex-direction: column;
    height: 85dvh;
  }

  .case__head {
    flex: none;
  }

  /*
   * Ховер карточки объявляется здесь, а срабатывает и здесь, и в дочерних
   * компонентах. Scoped-стили Astro до дочерних не достают, а CSS-переменные
   * наследуются вниз свободно — поэтому карточка говорит, ЧТО происходит при
   * наведении, а серый контейнер с экранами подставляет это у себя. Раньше
   * эффект жил целиком в дочернем компоненте и потому включался только при
   * наведении на сам контейнер, а не на карточку.
   *
   * Отзывается только обложка — экраны поднимаются на 8px каскадом слева
   * направо с шагом `--case-hover-stagger`, серый контейнер под ними чуть
   * темнеет. Заголовок и плашки не меняются вовсе: и подъём, и насыщенность
   * у них владелец снял. Ловится эффект при этом с любого места карточки —
   * ради этого он и переехал на переменные.
   *
   * Эффекта в макете нет — он отклик на то, что карточка целиком ссылка.
   */
  a.case__inner:hover {
    --case-hover-surface: #efefef;
    --case-hover-lift: -8px;
    --case-hover-stagger: 60ms;
  }

  /* Подпрыгивание при отключённой анимации превратилось бы в дёрганье:
     глобальное правило в global.css гасит длительность перехода, но сам
     сдвиг остаётся — его и убираем. Фон при этом продолжает меняться. */
  @media (prefers-reduced-motion: reduce) {
    a.case__inner:hover {
      --case-hover-lift: 0px;
    }
  }
</style>
