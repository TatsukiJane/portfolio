---
import Badge from './Badge.astro';
import PhoneShots from './PhoneShots.astro';
import type { CollectionEntry } from 'astro:content';

/**
 * Карточка кейса на главной: заголовок, плашки с метриками и серый контейнер
 * с экранами приложения.
 *
 * Контейнер с экранами вынесен в PhoneShots — в макете это тот же узел,
 * что и в первом экране страницы кейса.
 *
 * Пока карточка не ссылка: страница кейса свёрстана только частично.
 * Когда она будет готова, содержимое оборачивается в <a href={`/cases/${entry.id}`}>.
 */
interface Props {
  entry: CollectionEntry<'cases'>;
}

const { entry } = Astro.props;
const { title, metrics, tags, shots } = entry.data;
---

<article class="case">
  <div class="case__head">
    <h3 class="case__title">{title}</h3>

    {
      (metrics.length > 0 || tags.length > 0) && (
        <div class="case__badges">
          {metrics.map((metric) => (
            <Badge variant="success" label={`${metric.value} ${metric.label}`} />
          ))}
          {tags.map((tag) => (
            <Badge variant="neutral" label={tag} />
          ))}
        </div>
      )
    }
  </div>

  {shots.length > 0 && <PhoneShots shots={shots} interactive />}
</article>

<style>
  /* Курсор-указатель вместе с ховером обещают клик — когда страница кейса
     будет готова, карточка станет ссылкой. */
  .case {
    cursor: pointer;
  }

  .case__head {
    margin-bottom: var(--space-6); /* 32px до серого контейнера */
  }

  .case__title {
    max-width: 888px;
    margin-bottom: var(--space-5); /* 24px до плашек */
  }

  .case__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--column-gap);
  }
</style>
