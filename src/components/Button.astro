---
import Icon, { type IconName } from './Icon.astro';

/**
 * Кнопка-ссылка во всех начертаниях, которые встречаются в макете.
 *
 * variant:
 *   primary — чёрная заливка (Telegram в hero, шапке и футере)
 *   subtle  — серая заливка на белом фоне (LinkedIn и CV в hero)
 *   plain   — белая заливка на сером фоне (плитки футера)
 *   ghost   — без фона, подпись чёрная (ссылки в шапке)
 *   text    — без фона, подпись серая («Назад на главную» в конце кейса)
 *
 * size:
 *   md   — высота 56px, кнопки в hero
 *   sm   — высота 32px, шапка
 *   tile — плитка 152px высотой, футер
 *   bare — без полей, высота в строку (20px); слот иконки 20 вместо 24
 */
interface Props {
  href: string;
  label: string;
  icon?: IconName;
  variant?: 'primary' | 'subtle' | 'plain' | 'ghost' | 'text';
  size?: 'md' | 'sm' | 'tile' | 'bare';
  /** Открывать в новой вкладке — для внешних адресов и PDF. */
  newTab?: boolean;
  class?: string;
}

const {
  href,
  label,
  icon,
  variant = 'subtle',
  size = 'md',
  newTab = false,
  class: className,
} = Astro.props;

const target = newTab ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a
  href={href}
  class:list={['button', `button--${variant}`, `button--${size}`, className]}
  {...target}
>
  {/* Слот иконки в макете везде 24, и только у bare-кнопки 20 — scoped-стили
      Astro до svg внутри Icon не достают, поэтому размер идёт пропом. */}
  {icon && <Icon name={icon} size={size === 'bare' ? 20 : undefined} />}
  <span class="button__label">{label}</span>
</a>

<style>
  /* Подпись кнопки в макете — label/smallStrong: Manrope Bold 16/20.
     Исключение — ghost-ссылки навигации, у них обычный body/small (ниже). */
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* В макете между слотом иконки и обёрткой подписи 4px, и у самой
       обёртки ещё 4px по бокам — вместе 8px до текста. */
    gap: var(--space-1);
    font-size: var(--label-strong-size);
    font-weight: var(--weight-bold);
    line-height: var(--label-strong-height);
    white-space: nowrap;
    border-radius: var(--radius-control);
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .button__label {
    padding-inline: var(--space-1);
  }

  /* У ссылок навигации подпись стоит без обёртки — в макете так же. */
  .button--ghost .button__label {
    padding-inline: 0;
  }

  /* --- Заливки --- */

  .button--primary {
    color: var(--text-on-color);
    background: var(--surface-primary);
  }

  .button--primary:hover {
    /* Чёрный осветляем — затемнять уже некуда. */
    background: #262626;
  }

  .button--subtle {
    color: var(--text-primary);
    background: var(--surface-secondary);
  }

  .button--subtle:hover {
    background: #ebebeb;
  }

  .button--plain {
    color: var(--text-primary);
    background: var(--surface-base);
  }

  .button--plain:hover {
    background: #fafafa;
  }

  /* Ссылки навигации — не «кнопки» по типографике: body/small, Medium 16/24. */
  .button--ghost {
    color: var(--text-primary);
    font-weight: var(--weight-medium);
    line-height: var(--body-small-height);
    background: transparent;
  }

  .button--ghost:hover {
    background: var(--surface-secondary);
  }

  /* В макете подпись и иконка серые (text/neutral/tertiary). Ховера у кнопки
     в макете нет — она ссылка, поэтому по наведению подпись чернеет. */
  .button--text {
    color: var(--text-tertiary);
    background: transparent;
  }

  .button--text:hover {
    color: var(--text-primary);
  }

  /* --- Размеры ---
     Правил тут нет только у bare: в макете это 174×20 без полей, а 20 —
     интерлиньяж подписи, он и держит высоту. Весь размер и сводится к тому,
     что полей и высоты от md/sm/tile у кнопки не появляется. */

  .button--md {
    height: var(--control-height);
    padding-inline: var(--space-4); /* 16px, как в макете */
  }

  .button--sm {
    height: var(--control-height-compact);
    padding-inline: var(--space-3); /* 12px — ссылки навигации, ширина 73/89/97 в макете */
  }

  /* Кнопка Telegram в шапке: в макете поля разные — 8px слева под иконку
     и 12px справа за подписью. */
  .button--sm.button--primary {
    padding-left: var(--space-2);
    padding-right: var(--space-3);
  }

  /* Плитки футера: 301×152 в макете, ширину задаёт сетка. */
  .button--tile {
    height: 152px;
    padding-inline: var(--space-5);
    border-radius: var(--radius-large);
  }
</style>
