---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Экран приложения в рамке браузера — мокап веб-кейса. В макете компонент
 * называется MockupDesktop (узел `4323:12545`).
 *
 * Размеры из макета: экран 1008×630 в слайдере «Решений» и 1104×632
 * в первом экране кейса, скругление 8, рамка 3px. Рамка, как и у телефонов,
 * нарисована наружу — проверено по рендеру контейнера 1240×760: экран
 * занимает столбцы 68–1171, а тёмная рамка ложится на 65–67 и 1172–1174.
 * Отсюда `outline`, а не `border`: иначе экран сожмётся на 6px, и подписи,
 * стоящие по координатам макета, промахнутся мимо элементов.
 *
 * Пока картинок нет, на месте экрана стоит заглушка: рамка та же, внутри —
 * подпись экрана. Появится `src` — заглушка сменится картинкой без правок
 * вёрстки.
 *
 * `densities` обязателен по той же причине, что и у телефонов: без него
 * Astro отдаёт одну картинку ровно в `width`, и на retina она растягивается.
 * Значит и экспорт нужен не меньше 2×: 2016×1260 для слайдера, 2208×1264
 * для первого экрана.
 */
interface Props {
  alt: string;
  src?: ImageMetadata;
  /** Размер самого экрана, без рамки. */
  width?: number;
  height?: number;
  /**
   * Грузить сразу и с высоким приоритетом — для первого экрана страницы:
   * там мокап и есть самый крупный элемент видимой области (LCP).
   */
  eager?: boolean;
}

const { alt, src, width = 1008, height = 630, eager = false } = Astro.props;
---

<div class="mockup" style={`--mockup-width: ${width}; --mockup-height: ${height}`}>
  {
    src ? (
      <Image
        src={src}
        alt={alt}
        width={width}
        height={height}
        densities={[1, 2]}
        loading={eager ? 'eager' : undefined}
        fetchpriority={eager ? 'high' : undefined}
      />
    ) : (
      <p class="mockup__placeholder">{alt}</p>
    )
  }
</div>

<style>
  /* Радиус задан экрану (8), внешний край рамки браузер скругляет сам.
     Размеры приходят числами, а не длинами: из тех же чисел собирается
     `aspect-ratio`, чтобы при ограничении высоты (обложка карточки умеет
     ужиматься) ширина уезжала пропорционально, а не искажала экран.
     Пока обе стороны заданы, `aspect-ratio` ни на что не влияет. */
  .mockup {
    width: calc(var(--mockup-width) * 1px);
    height: calc(var(--mockup-height) * 1px);
    aspect-ratio: var(--mockup-width) / var(--mockup-height);
    overflow: clip;
    background: var(--surface-base);
    border-radius: var(--radius-card);
    outline: 3px solid var(--surface-device);
  }

  .mockup :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Заглушка: видно, какой экран сюда встанет, и что он ещё не встал. */
  .mockup__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: var(--space-5);
    color: var(--text-tertiary);
    font-size: var(--body-extra-small-size);
    line-height: var(--body-extra-small-height);
    text-align: center;
    background: var(--surface-secondary);
  }
</style>
