---
/**
 * Термин с определением, всплывающим при наведении.
 *
 * Подсказка встаёт снизу и выравнивается по началу термина: взгляд идёт
 * дальше по чтению — вниз и влево, — а не возвращается назад.
 *
 * В макете тултипа нет, всё собрано из токенов проекта: чёрная заливка
 * кнопок, радиус плиток, кегль body/small, ширина 301 (плитка из сетки).
 * Хвостика нет намеренно: подсказка умеет переворачиваться, когда снизу
 * или справа не хватает места, а хвостик за ней не переедет — CSS не даёт
 * перестилизовать псевдоэлемент под выбранный вариант позиции.
 *
 * Без JS: показ на :hover и :focus-visible. Термин получает tabindex, иначе
 * определение было бы недоступно с клавиатуры, а aria-describedby связывает
 * его с плашкой для скринридера.
 */
interface Props {
  /**
   * Без определения термин остаётся подчёркнутым, но подсказки не обещает:
   * в макете такие слова тоже подчёркнуты, а объяснения им нет.
   */
  definition?: string;
}

const { definition } = Astro.props;
const id = definition ? `term-${crypto.randomUUID().slice(0, 8)}` : undefined;
/* Имя якоря уникально на каждый термин: одно имя на несколько элементов
   в CSS anchor positioning разрешается в последний из них. */
const anchor = id && `--anchor-${id}`;
---

<span
  class:list={['term', !definition && 'term--plain']}
  style={anchor ? `anchor-name: ${anchor}` : undefined}
  tabindex={definition ? 0 : undefined}
  aria-describedby={id}
>
  <slot />
  {/* Зазор до термина лежит внутри подсказки полями сверху и снизу: мышь
      проходит его, не теряя наведения, и зазор остаётся на месте, с какой
      стороны подсказка бы ни раскрылась. */}
  {
    definition && (
      <span class="term__tip" style={`position-anchor: ${anchor}`} id={id} role="tooltip">
        <span class="term__bubble">{definition}</span>
      </span>
    )
  }
</span>

<style>
  .term {
    position: relative;
    cursor: help;
    text-decoration: underline dotted;
    text-decoration-thickness: 10%;
    /* В макете линия не прилипает к тексту: с браузерным авто-отступом она
       цепляла нижние выносные буквы, с 3px встаёт в те же ряды пикселей,
       что в рендере макета. */
    text-underline-offset: 3px;
  }

  /* Пунктир становится сплошным — знак, что подсказка уже открыта. */
  .term:hover,
  .term:focus-visible {
    text-decoration-style: solid;
  }

  /* Термин без определения: подчёркивание как в макете — сплошное, — и никаких
     обещаний интерактивности. */
  .term--plain {
    cursor: inherit;
    text-decoration-style: solid;
  }

  /* Снизу и по левому краю термина. */
  .term__tip {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 1;
    width: max-content;
    max-width: 301px; /* ширина плитки из сетки макета */
    padding-block: var(--space-2);
    /*
     * display: none, а не visibility: hidden — иначе браузер выбирает место
     * подсказки один раз, при первой раскладке страницы, когда термин ещё
     * далеко за пределами экрана, и держится за этот выбор. Убранная из
     * раскладки подсказка примеряет место в тот момент, когда её открывают.
     * allow-discrete и @starting-style сохраняют при этом плавное появление.
     */
    display: none;
    opacity: 0;
    transform: translateY(calc(var(--space-1) * -1));
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      display 0.15s allow-discrete;
  }

  /*
   * Корнер-кейсы: термин у нижней кромки окна или у правого края колонки.
   * Браузер сам примеряет варианты и переворачивает подсказку наверх или
   * вправо, если на месте она не помещается. Работает там, где есть CSS
   * anchor positioning (Chromium); где нет — подсказка всегда раскрывается
   * снизу-слева, то есть в задуманном положении.
   */
  @supports (anchor-name: --a) {
    /* Термин перестаёт быть содержащим блоком: примерка вариантов идёт по
       границам содержащего блока, и пока им был сам термин, сравнивать было
       не с чем — подсказка не переворачивалась. Без позиционированного предка
       границами становится видимая часть страницы. Место подсказке при этом
       задаёт якорь, а не поток. */
    .term {
      position: static;
    }

    /* Место задаётся областью, а не парой top/left: с областями браузер сам
       считает отступы и сам примеряет запасные варианты. Основной —
       снизу от термина, вправо от его левого края. */
    .term__tip {
      top: auto;
      left: auto;
      position-area: block-end span-inline-end;
      position-try-fallbacks:
        block-start span-inline-end,
        block-end span-inline-start,
        block-start span-inline-start;
    }
  }

  .term:hover .term__tip,
  .term:focus-visible .term__tip {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  @starting-style {
    .term:hover .term__tip,
    .term:focus-visible .term__tip {
      opacity: 0;
      transform: translateY(calc(var(--space-1) * -1));
    }
  }

  /*
   * Подчёркивание не наследуется: подсказка вынута из потока.
   * Ограничение по высоте — на случай очень длинного определения: плашка
   * не вырастает во всё окно, а прокручивается внутри. Прокрутка работает
   * и мышью: подсказка лежит внутри термина, поэтому наведение не теряется.
   */
  .term__bubble {
    display: block;
    max-height: 50vh;
    padding: var(--space-3) var(--space-4);
    overflow-y: auto;
    overscroll-behavior: contain;
    color: var(--text-on-color);
    font-size: var(--body-small-size);
    font-weight: var(--weight-medium);
    line-height: var(--body-small-height);
    text-align: left;
    background: var(--surface-primary);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-popover);
  }
</style>
