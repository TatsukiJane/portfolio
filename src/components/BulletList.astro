---
import Icon from './Icon.astro';
import RichText from './RichText.astro';

/**
 * Список с иконкой-маркером внутри текстового блока кейса.
 *
 * marker:
 *   star    — серая искра, нейтральный перечень («Действия»)
 *   insight — жёлтая звезда, находки исследования
 *   success — зелёная стрелка вверх и зелёный текст («Результат»)
 *   done    — зелёная галочка при обычном тексте («Что сработало»)
 *
 * Маркер стоит в слоте 24px, отступ до текста уже заложен в сам файл иконки:
 * у искры глиф 12×12 внутри слота, поэтому у строки зазора нет. У стрелки
 * глиф шире, и в макете ей добавлены 2px, у галочки — 6px.
 */
interface Props {
  items: string[];
  marker?: 'star' | 'insight' | 'success' | 'done';
  /** Словарь терминов для разметки `[[ключ|слово]]` внутри строк. */
  terms?: Record<string, string>;
}

const { items, marker = 'star', terms } = Astro.props;

/* Цвет искры и звезды зашит в сами файлы — он осмысленный, а не служебный. */
const icons = {
  star: 'star-bullet-sparkle',
  insight: 'star-bullet',
  success: 'up',
  done: 'done',
} as const;
---

<ul class:list={['list', `list--${marker}`]}>
  {
    items.map((item) => (
      <li class="list__item">
        <span class="list__marker">
          <Icon name={icons[marker]} />
        </span>
        <span>
          <RichText text={item} terms={terms} />
        </span>
      </li>
    ))
  }
</ul>

<style>
  .list {
    display: grid;
    gap: var(--space-2); /* 8px: строки идут с шагом 32px при высоте 24px */
    margin: 0;
  }

  .list__item {
    display: flex;
    align-items: flex-start;
  }

  .list__marker {
    flex-shrink: 0;
  }

  .list--star,
  .list--insight,
  .list--done {
    color: var(--text-secondary);
  }

  .list--success {
    color: var(--text-success);
  }

  .list--success .list__item {
    gap: 2px;
  }

  /* У галочки цвет свой: в макете она зелёная, а текст рядом — обычный. */
  .list--done .list__item {
    gap: 6px;
  }

  .list--done .list__marker {
    color: var(--text-success);
  }
</style>
