---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Экран приложения в рамке телефона внутри слайдера кейса.
 *
 * Размеры из макета: 288×624, рамка 4px, скругление 36 по внешнему краю —
 * здесь border-box, поэтому внутренний радиус получается 32, как в макете
 * (в hero кейса рамка нарисована наружу и считается иначе).
 *
 * Пока картинок нет, на их месте стоит заглушка: рамка та же, внутри —
 * подпись экрана. Как только появится `src`, заглушка сменится картинкой
 * без правок вёрстки.
 *
 * `densities` обязателен: без него Astro отдаёт одну картинку ровно в
 * `width`, и на retina 280px растягиваются на 560 физических — мелкий
 * текст внутри экрана превращается в кашу. Отсюда и требование к экспорту:
 * исходник не меньше 560×1232, иначе второй плотности неоткуда взяться.
 */
interface Props {
  alt: string;
  src?: ImageMetadata;
}

const { alt, src } = Astro.props;
---

<div class="mockup">
  {
    src ? (
      <Image src={src} alt={alt} width={288} height={624} densities={[1, 2]} />
    ) : (
      <p class="mockup__placeholder">{alt}</p>
    )
  }
</div>

<style>
  .mockup {
    position: relative;
    box-sizing: border-box;
    width: 288px;
    height: 624px;
    overflow: clip;
    background: var(--surface-base);
    border: 4px solid var(--surface-device);
    border-radius: 36px;
  }

  /* Экран лежит ПОД рамкой, а не внутри неё: в макете обводка мокапа
     нарисована поверх картинки, поэтому картинка занимает все 288×624,
     а видно из неё 280×616. Проверено по масштабу содержимого в рендере
     макета — 0.2497, то есть 288/1152, а не 280/1152 и не 616/2498.
     Отсюда и размер экспорта: 2× от рамки, 576×1248. */
  .mockup :global(img) {
    position: absolute;
    inset: -4px;
    /* Общий сброс держит `max-width: 100%`, а он считается от места внутри
       рамки (280) и зажимал бы картинку — ей же нужно быть шире его. */
    max-width: none;
    object-fit: cover;
  }

  /* Заглушка: видно, какой экран сюда встанет, и что он ещё не встал. */
  .mockup__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: var(--space-5);
    color: var(--text-tertiary);
    font-size: var(--body-extra-small-size);
    line-height: var(--body-extra-small-height);
    text-align: center;
    background: var(--surface-secondary);
  }
</style>
