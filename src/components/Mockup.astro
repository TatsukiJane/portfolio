---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Экран приложения в рамке телефона внутри слайдера кейса.
 *
 * Размеры из макета: экран 288×624 со скруглением 32, рамка 4px нарисована
 * наружу от него — как и в мокапах на главной. Поэтому рамка не занимает
 * места в раскладке: ряд из трёх экранов остаётся 1008 (3×288 + 2×72),
 * а рамки выходят за его края.
 *
 * Пока картинок нет, на их месте стоит заглушка: рамка та же, внутри —
 * подпись экрана. Как только появится `src`, заглушка сменится картинкой
 * без правок вёрстки.
 *
 * `densities` обязателен: без него Astro отдаёт одну картинку ровно в
 * `width`, и на retina 288px растягиваются на 576 физических — мелкий
 * текст внутри экрана превращается в кашу. Отсюда и требование к экспорту:
 * исходник не меньше 576×1248, иначе второй плотности неоткуда взяться.
 */
interface Props {
  alt: string;
  src?: ImageMetadata;
}

const { alt, src } = Astro.props;
---

<div class="mockup">
  {
    src ? (
      <Image src={src} alt={alt} width={288} height={624} densities={[1, 2]} />
    ) : (
      <p class="mockup__placeholder">{alt}</p>
    )
  }
</div>

<style>
  /* Рамка нарисована через outline: он не входит в раскладку и рисуется
     наружу от края — ровно как обводка мокапа в макете. С `border` рамка
     съела бы по 4px с каждой стороны экрана, экран стал бы 280×616 и
     содержимое уехало бы на 4px вверх и влево. Выносок это касается
     напрямую: они стоят по координатам макета и промахивались мимо
     элементов, на которые указывают.
     Радиус задан экрану (32), внешний край рамки браузер скругляет сам —
     получается 36, как в макете. */
  .mockup {
    position: relative;
    width: 288px;
    height: 624px;
    overflow: clip;
    background: var(--surface-base);
    border-radius: 32px;
    outline: 4px solid var(--surface-device);
  }

  .mockup :global(img) {
    display: block;
  }

  /* Заглушка: видно, какой экран сюда встанет, и что он ещё не встал. */
  .mockup__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: var(--space-5);
    color: var(--text-tertiary);
    font-size: var(--body-extra-small-size);
    line-height: var(--body-extra-small-height);
    text-align: center;
    background: var(--surface-secondary);
  }
</style>
