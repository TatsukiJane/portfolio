---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Mockup from './Mockup.astro';
import MockupDesktop from './MockupDesktop.astro';
import type { CaseSliderBlock } from '../content.config.ts';

/**
 * Серый контейнер с экранами и подписями к ним. В макете компонент называется
 * CaseInfoSlider (узел `4127:1297`) и имеет два флага: несколько слайдов
 * (тогда появляются стрелки и точки) и заголовок над содержимым. Заголовок
 * нарисован снаружи слота, но у слайдера «стало» в шаге «Подписание
 * документа» он на каждом слайде свой — значит принадлежит слайду.
 *
 * Изображения здесь — только сами экраны и выноски (кривые линии между
 * ними, экспортированные из макета: текста в них нет, переводу они не
 * мешают). Подписи, стрелки, точки и выделения собраны кодом: так их можно
 * перевести на английский, не перерисовывая картинки.
 *
 * Размеры из макета: контейнер 1240 при полях 48/80, ряд экранов и ряд
 * подписей по 1008 с зазором 72, между рядами 32.
 *
 * У веб-кейса мокап один и ровно той же ширины 1008 — раскладка не меняется,
 * меняется только рамка (MockupDesktop) и то, что подписи лежат поверх
 * экрана, а не рядом под ним.
 */
type Props = Omit<CaseSliderBlock, 'type' | 'gapBefore'>;

const { tone = 'problem', device = 'phone', slides } = Astro.props;

/* Управление нужно только когда листать есть что. */
const isSlider = slides.length > 1;

/*
 * Вынос обводки в экспортированных SVG-выносках: линия рисуется по рамке
 * узла, и штрих выступает за неё на полтолщины. У всех пяти выносок макета
 * вынос одинаковый — 2.887px слева, сверху и снизу (справа нет: там линия
 * кончается стрелкой внутрь рамки). В контенте записана рамка узла из
 * макета, а сдвиг картинки под вынос считается здесь.
 */
const bleed = 2.887;
---

{/*
  У слайдера с несколькими слайдами роль объявлена явно: скринридер сообщает,
  что это слайдер и какой слайд из скольких открыт. У одиночного объявлять
  нечего — это просто ряд картинок.
*/}
<div
  class:list={['slider', `slider--${tone}`]}
  data-slider
  role={isSlider ? 'group' : undefined}
  aria-roledescription={isSlider ? 'слайдер' : undefined}
  aria-label={isSlider ? 'Экраны приложения' : undefined}
>
  {/*
    Дорожка прокручивается по горизонтали с прилипанием — листать можно
    и без скрипта, колесом или тачпадом. Скрипт добавляет только стрелки
    и точки.
  */}
  <div class="slider__track" data-track>
    {
      slides.map((slide, index) => (
        <div
          class="slider__slide"
          role={isSlider ? 'group' : undefined}
          aria-roledescription={isSlider ? 'слайд' : undefined}
          aria-label={isSlider ? `${index + 1} из ${slides.length}` : undefined}
        >
          {slide.title && <p class="slider__title">{slide.title}</p>}

          <div class="slider__shots">
            {slide.shots.map((shot) =>
              device === 'desktop' ? (
                <MockupDesktop alt={shot.alt} src={shot.src} />
              ) : (
                <Mockup alt={shot.alt} src={shot.src} />
              ),
            )}

            {/* Подписи, лежащие на самом экране: в веб-кейсе места под
                экраном нет, и в макете они набраны поверх него. */}
            {slide.callouts.map((callout) => (
              <p
                class="slider__comment slider__comment--pinned"
                style={`left: ${callout.x}px; top: ${callout.y}px; width: ${callout.width}px`}
              >
                {callout.text}
              </p>
            ))}

            {/* Выделения лежат поверх экранов по координатам макета. */}
            {slide.highlights.map((spot) => (
              <span
                class="slider__highlight"
                style={`left: ${spot.x}px; top: ${spot.y}px; width: ${spot.width}px; height: ${spot.height}px`}
              />
            ))}

            {/* Выноски — кривые от элемента одного экрана к другому. */}
            {slide.connectors.map((line) => (
              <Image
                class="slider__connector"
                src={line.src}
                alt=""
                style={`left: ${line.x - bleed}px; top: ${line.y - bleed}px; width: ${line.width + bleed}px; height: ${line.height + 2 * bleed}px`}
              />
            ))}
          </div>

          {slide.comments.length > 0 && (
            /* Одна подпись при нескольких экранах относится ко всему слайду —
               в макете она и набрана на всю ширину ряда. */
            <div
              class:list={[
                'slider__comments',
                slide.comments.length === 1 && slide.shots.length > 1 && 'slider__comments--whole',
              ]}
              style={`--shots: ${slide.shots.length}`}
            >
              {slide.comments.map((comment) =>
                /* Пустая строка — не подпись, а её место: столбец под своим
                   экраном остаётся, но плашка не рисуется. */
                comment ? <p class="slider__comment">{comment}</p> : <span />,
              )}
            </div>
          )}
        </div>
      ))
    }
  </div>

  {
    isSlider && (
      <>
        {/* Стрелка «назад» на первом слайде выключена сразу: дальше состояние
            стрелок ведёт скрипт. */}
        <button
          class="slider__nav slider__nav--prev"
          type="button"
          data-prev
          disabled
          aria-label="Предыдущий слайд"
        >
          <Icon name="arrow-left" />
        </button>
        <button class="slider__nav slider__nav--next" type="button" data-next aria-label="Следующий слайд">
          <Icon name="arrow-right" />
        </button>

        <div class="slider__dots">
          {slides.map((_, index) => (
            <button
              class="slider__dot"
              type="button"
              data-dot
              aria-label={`Слайд ${index + 1} из ${slides.length}`}
              aria-current={index === 0 ? 'true' : undefined}
            />
          ))}
        </div>
      </>
    )
  }
</div>

<style>
  .slider {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6); /* 32px между заголовком, экранами и точками */
    padding: var(--space-10) var(--space-8); /* 80 по вертикали, 48 по бокам */
    overflow: clip;
    background: var(--surface-secondary);
    border-radius: var(--radius-large);
  }

  /* Заголовок в макете шириной 596 и с полем 12 снизу. */
  .slider__title {
    width: 596px;
    padding-bottom: var(--space-3);
    color: var(--text-primary);
    font-size: var(--title-h5-size);
    font-weight: var(--weight-semibold);
    line-height: var(--title-h5-height);
    text-align: center;
  }

  /* Прилипание объявлено для случая без скрипта; со скриптом он снимает его
     и доводит дорожку сам (см. комментарий в script). overscroll-behavior
     держит жест внутри слайдера: дотянув дорожку до края, тачпад иначе
     уводит браузер назад по истории. */
  /* Поля по 4px с обратными полями — место под рамки мокапов. Рамка нарисована
     наружу от экрана (см. Mockup.astro), а `overflow-x: auto` по правилам CSS
     превращает вертикальную видимость в `auto` — то есть дорожка обрезает всё,
     что выходит за её края по вертикали. У слайдов без заголовка и без подписей
     ряд экранов стоит вплотную к краю, и у телефонов срезало кромку рамки.
     Обратные поля возвращают дорожке прежний размер в раскладке. */
  .slider__track {
    display: flex;
    width: 100%;
    margin-block: -4px;
    padding-block: 4px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .slider__track--draggable {
    cursor: grab;
  }

  .slider__track--dragging {
    cursor: grabbing;
    /* На случай, если выделение началось до нажатия. */
    user-select: none;
  }

  .slider__track::-webkit-scrollbar {
    display: none;
  }

  /* Слайд занимает дорожку целиком — так шаг листания равен одному слайду.
     min-width: 0 обязателен: без него слайд с содержимым шире дорожки
     (проверено на четырёх экранах вместо трёх — 1368 против 1144) растёт
     по содержимому, и следующие за ним слайды съезжают с шага листания. */
  .slider__slide {
    display: flex;
    flex: 0 0 100%;
    flex-direction: column;
    /* Высоту дорожке задаёт самый высокий слайд, поэтому короткие слайды
       ниже неё. Содержимое центрируется по вертикали — прижатое к верху
       смотрится случайным. В макете каждый слайд нарисован отдельным
       контейнером своей высоты, так что пустого места там нет вовсе. */
    justify-content: center;
    align-items: center;
    gap: var(--space-6);
    min-width: 0;
    scroll-snap-align: center;
  }

  /* Ряд экранов: 3 × 288 при зазоре 72 даёт ровно 1008, как в макете. */
  .slider__shots {
    position: relative;
    display: flex;
    gap: 72px;
    align-items: center;
  }

  .slider__highlight {
    position: absolute;
    border: 1px solid var(--border-comment-problem);
    border-radius: 50%;
  }

  /* Выноска — декорация: курсор и клики сквозь неё проходят к экрану. */
  .slider__connector {
    position: absolute;
    pointer-events: none;
  }

  /* Подписи стоят под своими экранами и той же ширины. */
  .slider__comments {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 288px;
    gap: 72px;
    /* В макете подписи в ряду одной высоты — там она добрана пустыми
       строками в тексте. Растягиваем ряд вместо этого: с переводом на другой
       язык пустые строки перестали бы совпадать. */
    align-items: stretch;
  }

  /* Одна подпись на весь ряд экранов — так в макете набран второй слайд
     «стало»: подпись там относится к паре экранов целиком, а не к одному
     из них. Ширину приходится считать по числу экранов: столбцов больше нет,
     а тянуться на всю ширину слайда (1144) подписи нельзя — ряд экранов
     уже 1008. */
  .slider__comments--whole {
    display: block;
    width: calc(var(--shots) * 288px + (var(--shots) - 1) * 72px);
  }

  /* Поля 71 по бокам и выключка по центру — из макета. */
  .slider__comments--whole .slider__comment {
    padding-inline: 71px;
    text-align: center;
  }

  /* Обводка нарисована внутренней тенью, а не border: в макете она не
     увеличивает плашку, и с border ряд подписей становился на 2px выше.
     Та же тень держит точной и ширину подписи, лежащей поверх экрана. */
  .slider__comment {
    padding: var(--space-4);
    font-size: var(--body-extra-small-size);
    line-height: var(--body-extra-small-height);
    border-radius: var(--radius-card);
  }

  /* Подпись поверх экрана: положение и ширина приходят из макета, высоту
     задаёт текст. Ряд экранов — содержащий блок, поэтому система координат
     у неё та же, что у выделений и выносок. */
  .slider__comment--pinned {
    position: absolute;
  }

  .slider--problem .slider__comment {
    color: var(--text-comment-problem);
    background: var(--surface-comment-problem);
    box-shadow: inset 0 0 0 1px var(--border-comment-problem);
  }

  .slider--solution .slider__comment {
    color: var(--text-comment-solution);
    background: var(--surface-comment-solution);
    box-shadow: inset 0 0 0 1px var(--border-comment-solution);
  }

  /* --- Управление --- */

  /* Стрелки в макете стоят в 48px от краёв и сдвинуты на 8px ниже центра:
     так они попадают в середину экранов, а не всего контейнера с подписями. */
  .slider__nav {
    position: absolute;
    top: calc(50% + 8px);
    display: flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding-inline: var(--space-2);
    background: var(--surface-control-overlay);
    border: 1px solid var(--border-control-overlay);
    border-radius: var(--radius-small);
    transform: translateY(-50%);
    transition: background-color 0.15s ease;
  }

  .slider__nav:hover:not(:disabled) {
    background: rgb(0 0 0 / 20%);
  }

  /* На крайних слайдах стрелка выключается. В макете такого состояния нет:
     там нарисован один слайд, и дальше листать некуда. Молча неработающая
     стрелка хуже — по ней не понять, что слайды кончились; курсор тоже
     говорит, что нажимать нечего. */
  .slider__nav:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .slider__nav--prev {
    left: var(--space-8);
  }

  .slider__nav--next {
    right: var(--space-8);
  }

  .slider__dots {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .slider__dot {
    position: relative;
    width: 8px;
    height: 8px;
    padding: 0;
    background: var(--surface-neutral-tertiary);
    border-radius: var(--radius-small);
  }

  /* Зона нажатия больше самой точки: 8×8 — слишком мелкая цель. По бокам
     запас меньше, чтобы зоны соседних точек не перекрывались (между
     точками 6px). Псевдоэлемент ловит клики, не меняя раскладку. */
  .slider__dot::after {
    content: '';
    position: absolute;
    inset: -8px -3px;
  }

  .slider__dot[aria-current] {
    background: var(--surface-primary);
  }
</style>

<script>
  /*
   * Единственный скрипт на странице кейса: стрелки и точки слайдера.
   * Разметка работает и без него — дорожка прокручивается штатно, с
   * прилипанием, поэтому падение скрипта не ломает содержимое.
   */
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((slider) => {
    const track = slider.querySelector<HTMLElement>('[data-track]');
    const dots = [...slider.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    if (!track || dots.length === 0) return;

    const prev = slider.querySelector<HTMLButtonElement>('[data-prev]');
    const next = slider.querySelector<HTMLButtonElement>('[data-next]');
    const slides = [...track.children] as HTMLElement[];
    const last = slides.length - 1;

    /* Позиция слайда считается по самому слайду, а не как «номер × ширина
       дорожки»: слайдов может быть сколько угодно, и лишний источник
       правды о их ширине ни к чему. */
    const offsetOf = (index: number) => slides[index].offsetLeft - slides[0].offsetLeft;

    /* Ближайший к текущей прокрутке слайд: работает и когда листают колесом
       или тачпадом, остановившись между слайдами. */
    const current = () =>
      slides.reduce(
        (best, _, index) =>
          Math.abs(offsetOf(index) - track.scrollLeft) < Math.abs(offsetOf(best) - track.scrollLeft)
            ? index
            : best,
        0,
      );

    let active = -1;
    const sync = () => {
      const index = current();
      if (index === active) return;
      active = index;

      dots.forEach((dot, position) =>
        position === index ? dot.setAttribute('aria-current', 'true') : dot.removeAttribute('aria-current'),
      );
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === last;
    };

    const go = (index: number) => {
      const target = Math.max(0, Math.min(last, index));
      track.scrollTo({
        left: offsetOf(target),
        /* Кому анимация мешает — тому мгновенно. */
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
      });
    };

    prev?.addEventListener('click', () => go(current() - 1));
    next?.addEventListener('click', () => go(current() + 1));
    dots.forEach((dot, index) => dot.addEventListener('click', () => go(index)));

    /*
     * Прилипание отдаётся скрипту. В CSS правило остаётся — без скрипта
     * дорожка прилипает сама, — но с `scroll-snap-type: mandatory` браузер
     * возвращает её к ближайшему слайду после каждого события прокрутки,
     * и горизонтальный жест тачпада не двигает слайдер вовсе: проверено,
     * 720px жеста дают 0 вместо 713. Поэтому прилипание снимается, а слайдер
     * сам доезжает до ближайшего слайда, когда прокрутка остановилась.
     */
    track.style.scrollSnapType = 'none';

    let dragging = false;
    let settleTimer = 0;

    /* Состояние ведётся от прокрутки, а не от нажатий: листать можно колесом,
       жестом тачпада и перетаскиванием. Сравнение с предыдущим слайдом внутри
       sync() отсекает лишние правки атрибутов — событие прокрутки приходит
       на каждый кадр. */
    track.addEventListener('scroll', () => {
      sync();

      /* Пауза в 100мс переживает и инерцию тачпада, и саму доводку: пока
         дорожка едет, событие приходит снова и таймер начинается заново.
         Когда доводить уже нечего, go() не вызывается и цикла не выходит. */
      clearTimeout(settleTimer);
      settleTimer = window.setTimeout(() => {
        if (dragging) return;
        const index = current();
        if (Math.abs(offsetOf(index) - track.scrollLeft) > 1) go(index);
      }, 100);
    });

    /*
     * Перетаскивание мышью. Пальцу и перу оно не нужно — там прокрутка
     * работает сама, а перехват её сломал бы.
     */
    track.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return;

      /* Отмена нажатия глушит выделение текста и перетаскивание картинок:
         без неё вместо слайдера тянется выделение. */
      event.preventDefault();

      dragging = true;
      const startX = event.clientX;
      const startLeft = track.scrollLeft;
      track.setPointerCapture(event.pointerId);
      track.classList.add('slider__track--dragging');

      const move = (moved: PointerEvent) => {
        track.scrollLeft = startLeft - (moved.clientX - startX);
      };

      const stop = () => {
        dragging = false;
        track.classList.remove('slider__track--dragging');
        track.removeEventListener('pointermove', move);
        track.removeEventListener('pointerup', stop);
        track.removeEventListener('pointercancel', stop);
        go(current());
      };

      track.addEventListener('pointermove', move);
      track.addEventListener('pointerup', stop);
      track.addEventListener('pointercancel', stop);
    });

    /*
     * Листание с клавиатуры. Раньше его давало само прилипание: браузер
     * прокручивал сфокусированную дорожку до следующей точки. Прилипание
     * снято, и без этого обработчика стрелка сдвигала бы дорожку на десяток
     * пикселей, а доводка возвращала бы её назад.
     */
    const keys: Record<string, (index: number) => number> = {
      ArrowRight: (index) => index + 1,
      ArrowLeft: (index) => index - 1,
      Home: () => 0,
      End: () => last,
    };

    track.addEventListener('keydown', (event) => {
      const step = keys[event.key];
      if (!step || event.altKey || event.ctrlKey || event.metaKey) return;
      event.preventDefault();
      go(step(current()));
    });

    /* Курсор появляется только вместе со скриптом: без него тянуть нечего. */
    track.classList.add('slider__track--draggable');

    sync();
  });
</script>
