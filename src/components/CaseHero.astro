---
import DesktopShot from './DesktopShot.astro';
import PhoneShots from './PhoneShots.astro';
import type { CollectionEntry } from 'astro:content';

/**
 * Первый экран страницы кейса: заголовок, метка платформы у правого края
 * и серый контейнер с экранами приложения.
 *
 * Ритм макета: экран начинается на 144px (44 шапки + 100 отступа),
 * от заголовка до контейнера 32px, высота контейнера 821px.
 *
 * У кейса про веб контейнер другой — 1240×760 с одним десктопным экраном
 * 1104×632 по центру; он приходит полем `cover`.
 */
interface Props {
  entry: CollectionEntry<'cases'>;
}

const { entry } = Astro.props;
const { title, titleLines, tags, shots, cover } = entry.data;

/* Разбивка на строки взята из макета; если её не задали — строка ломается сама. */
const lines = titleLines ?? [title];
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__head">
      <h1 class="hero__title">
        {
          /* Пробел перед <br> не виден, но без него заголовок копируется
             и индексируется одним словом. */
          lines.map((line, index) => (
            <>
              {index > 0 && (
                <>
                  {' '}
                  <br />
                </>
              )}
              {line}
            </>
          ))
        }
      </h1>

      {tags.length > 0 && <p class="hero__tags">{tags.join(', ')}</p>}
    </div>

    {/* eager: контейнер с экранами — в видимой области и LCP страницы. */}
    {
      cover ? (
        <DesktopShot shot={cover} eager />
      ) : (
        shots.length > 0 && <PhoneShots shots={shots} eager />
      )
    }
  </div>
</section>

<style>
  .hero {
    /* Шапка занимает 44px, а первый экран в макете начинается на 144px. */
    padding-top: 100px;
    padding-bottom: var(--space-section);
  }

  /* Первый экран живёт по тому же правилу, что карточка кейса на главной:
     блок занимает 85% высоты окна, заголовок держит свою высоту, обложка
     забирает остаток. В макете высота у неё фиксированная (821). */
  .hero__inner {
    display: flex;
    flex-direction: column;
    height: 85dvh;
  }

  /* Метка платформы прижата к правому краю и стоит на нижней строке
     заголовка — в макете её низ совпадает с низом H1. */
  .hero__head {
    flex: none;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-6); /* 32px до контейнера с экранами */
  }

  /* Ширину заголовку не ограничиваем: строки в нём разбиты вручную
     (`titleLines`), а в макете его рамка просто обтягивает текст — у второго
     кейса это 664px, то есть прежний предел 613 ломал бы строку лишний раз.
     От метки платформы заголовок и так отделён: она соседний флекс-элемент
     и место под себя забирает сама. */
  .hero__title {
    min-width: 0;
  }


  .hero__tags {
    color: var(--text-tertiary);
    font-size: var(--title-h5-size);
    font-weight: var(--weight-medium);
    line-height: var(--title-h5-height);
    white-space: nowrap;
  }
</style>
