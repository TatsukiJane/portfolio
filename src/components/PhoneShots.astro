---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

/**
 * Серый контейнер с мокапами телефонов.
 *
 * В макете это один и тот же узел и на главной (внутри CaseCard), и в первом
 * экране страницы кейса — поэтому компонент общий, а не скопированный.
 *
 * Размеры из макета: контейнер 1240×821, экран 320×693, рамка телефона 4px
 * рисуется наружу от экрана, зазор между рамками 56px.
 */
interface Props {
  shots: CollectionEntry<'cases'>['data']['shots'];
  /**
   * Отзываться на ховер карточки — подъёмом телефонов и фоном. Нужно там,
   * где контейнер обещает клик (карточка на главной); на странице кейса это
   * просто иллюстрация. Сами значения приходят переменными от CaseCard.
   */
  interactive?: boolean;
  /**
   * Грузить экраны сразу и с высоким приоритетом. Нужно первому экрану
   * страницы кейса: он в видимой области, и это самый крупный её элемент
   * (LCP) — ленивая загрузка там откладывает главную картинку страницы.
   * Карточкам на главной не нужно: они ниже сгиба, там lazy правильный.
   */
  eager?: boolean;
}

const { shots, interactive = false, eager = false } = Astro.props;
---

<div class:list={['shots', interactive && 'shots--interactive']}>
  {
    shots.map((shot) => (
      <div class="shots__device">
        {/* densities: без него Astro отдаёт одну картинку ровно в width,
            и на retina исходник 640×1386 ужимался бы до 320 — впустую. */}
        <Image
          src={shot.src}
          alt={shot.alt}
          width={320}
          height={693}
          densities={[1, 2]}
          loading={eager ? 'eager' : undefined}
          fetchpriority={eager ? 'high' : undefined}
        />
      </div>
    ))
  }
</div>

<style>
  .shots {
    display: flex;
    /* Поля 60/72 и зазор 56 подобраны так, чтобы внешние края рамок
       встали на те же позиции, что в макете. */
    gap: 56px;
    justify-content: center;
    padding: 60px 72px;
    background: var(--surface-secondary);
    border-radius: var(--radius-large);
    transition: background-color 0.3s ease;
  }

  /* Отклик на ховер приходит сверху переменными, а не берётся от
     собственного `:hover`: наводят на карточку целиком, а серый контейнер —
     лишь её часть. Значения объявляет CaseCard, здесь только места, куда
     они подставляются; без них (на странице кейса) всё остаётся как есть. */
  .shots--interactive {
    background: var(--case-hover-surface, var(--surface-secondary));
  }

  /* Рамка телефона: в макете она нарисована наружу от экрана,
     поэтому content-box, а не border-box.
     Скругление в макете задано экрану (40px), а CSS отсчитывает радиус
     от внешнего края рамки — отсюда 44: внутренний радиус получается
     ровно 40, иначе по углам остаётся заметный серп. */
  .shots__device {
    box-sizing: content-box;
    width: 320px;
    overflow: hidden;
    background: var(--surface-base);
    border: 4px solid var(--surface-primary);
    border-radius: 44px;
    transition: transform 0.3s ease;
  }

  /* Телефоны приподнимаются лёгким каскадом слева направо; шаг волны —
     `--case-hover-stagger`. Задержки тоже приходят переменной, и в этом
     весь трюк с возвратом: стоит курсору уйти, она исчезает вместе с
     задержками, и все опускаются разом. Так этот эффект и был задуман. */
  .shots--interactive .shots__device {
    transform: translateY(var(--case-hover-lift, 0));
  }

  .shots--interactive .shots__device:nth-child(2) {
    transition-delay: var(--case-hover-stagger, 0ms);
  }

  .shots--interactive .shots__device:nth-child(3) {
    transition-delay: calc(var(--case-hover-stagger, 0ms) * 2);
  }
</style>
