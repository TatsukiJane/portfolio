---
import MockupDesktop from './MockupDesktop.astro';
import type { ImageMetadata } from 'astro';

/**
 * Серый контейнер с одним десктопным экраном — первый экран кейса про веб
 * и та же плашка в его карточке на главной. Парный к PhoneShots: там ряд
 * телефонов, здесь один экран браузера.
 *
 * Размеры из макета (узел `4500:15114`): контейнер 1240×760, поля 64 сверху
 * и снизу, экран 1104×632 по центру — то есть 68 по бокам. Высота у контейнера
 * теперь не фиксированная: он забирает остаток от 85% высоты окна, которые
 * занимает карточка кейса (см. CaseCard). Экран остаётся макетным, пока
 * помещается, и ужимается пропорционально, когда места нет.
 */
interface Props {
  shot: { src?: ImageMetadata; alt: string };
  /**
   * Ховер. Нужен там, где контейнер обещает клик (карточка на главной);
   * на странице кейса это просто иллюстрация.
   */
  interactive?: boolean;
  /**
   * Грузить сразу и с высоким приоритетом — для первого экрана страницы,
   * где этот экран и есть LCP.
   */
  eager?: boolean;
}

const { shot, interactive = false, eager = false } = Astro.props;
---

<div class:list={['shot', interactive && 'shot--interactive']}>
  <MockupDesktop alt={shot.alt} src={shot.src} width={1104} height={632} eager={eager} />
</div>

<style>
  /* Полей сверху и снизу нет: обложка тянется по высоте, и они получаются
     сами — остаток делится поровну центрированием. В макете это ровно 64.
     `flex` — чтобы обложка забирала остаток высоты карточки (см. CaseCard);
     вне флекс-колонки строка ни на что не влияет. */
  .shot {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-secondary);
    border-radius: var(--radius-large);
    transition: background-color 0.3s ease;
    flex: 1;
    min-height: 0;
  }

  /*
   * Экран масштабируется под высоту обложки, оставляя 64 сверху и снизу.
   * Расти он может, пока по бокам остаётся хотя бы 32 — отсюда потолок 673:
   * при ширине контейнера 1240 на экран остаётся 1176, а это 673 по высоте
   * при его соотношении 1104:632. Выше окна ~1130 экран упирается в потолок,
   * и вертикальные поля становятся больше 64: шире контейнера он быть
   * не может.
   *
   * Боковые поля при этом уходят от макетных 68 — на окне 1080 их остаётся
   * 49. Так и задумано: владелец просил держать ровно 64 сверху и снизу,
   * а по горизонтали экран следует за этим.
   *
   * `width: auto` обязателен: с заданной шириной `aspect-ratio` не работает,
   * и ограничение по высоте сплющило бы экран вместо того, чтобы уменьшить
   * его целиком.
   */
  .shot :global(.mockup) {
    height: calc(100% - 128px);
    max-height: 673px;
    width: auto;
  }

  /* Тот же отклик, что у ряда телефонов, и приходит он так же — переменными
     сверху, а не от собственного `:hover`: наводят на карточку целиком,
     а серый контейнер лишь её часть. Значения объявляет CaseCard; без них
     (на странице кейса) контейнер остаётся неподвижным. */
  .shot--interactive {
    background: var(--case-hover-surface, var(--surface-secondary));
  }

  .shot :global(.mockup) {
    transition: transform 0.3s ease;
  }

  /* Экран один, каскаду не с кем идти — просто поднимается. */
  .shot--interactive :global(.mockup) {
    transform: translateY(var(--case-hover-lift, 0));
  }
</style>
