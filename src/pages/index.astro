---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Divider from '../components/Divider.astro';
import CaseCard from '../components/CaseCard.astro';
import { profile } from '../data/profile.ts';
import { ui } from '../data/ui.ts';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);

/*
 * Структурированные данные для поисковиков: кто владелец сайта и где его
 * профили. Только на главной — она и есть страница о человеке.
 */
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: 'Продуктовый дизайнер',
  url: Astro.site?.href,
  sameAs: [profile.links.linkedin, profile.links.telegram],
});
---

<BaseLayout title={`${profile.name}. Продуктовый дизайнер`}>
  <script is:inline type="application/ld+json" set:html={jsonLd} />
  <Hero />
  <Divider />

  <section class="cases" id="cases">
    <h2 class="visually-hidden">{ui.sections.cases}</h2>
    {
      cases.map((entry, index) => (
        <>
          {/* Разделители лежат вне контейнера: в макете линия идёт
              от края до края окна, а не по ширине контента. */}
          {index > 0 && <Divider />}
          <div class="container">
            <CaseCard entry={entry} />
          </div>
        </>
      ))
    }
  </section>
</BaseLayout>

<style>
  /* Вертикальный ритм макета: между секциями и разделителями ровно 160px,
     поэтому разделитель здесь — такой же элемент сетки, как карточка. */
  .cases {
    display: grid;
    gap: var(--space-section);
    padding-block: var(--space-section);
  }
</style>
