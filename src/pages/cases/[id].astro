---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseHero from '../../components/CaseHero.astro';
import CaseSection from '../../components/CaseSection.astro';
import CaseToc from '../../components/CaseToc.astro';
import Divider from '../../components/Divider.astro';
import { profile } from '../../data/profile.ts';
import { slugify } from '../../utils/slug.ts';

/*
 * Страница кейса собирается только у тех кейсов, где уже описаны разделы.
 * Заготовка без содержимого дала бы пустую страницу — и в sitemap тоже.
 */
export async function getStaticPaths() {
  const cases = await getCollection('cases');

  return cases
    .filter((entry) => entry.data.sections.length > 0)
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, sections } = entry.data;

/* Отдельного поля под описание в макете нет — берём первый абзац кейса. */
const description = sections
  .flatMap((section) => section.blocks)
  .find((block) => block.type === 'text')?.paragraphs[0];

/*
 * Словарь терминов: блок «Терминологии» с полем `term` даёт определение,
 * а разметка `[[ключ|слово]]` в тексте кейса на него ссылается. Так текст
 * определения хранится в одном месте — там, где его читают целиком.
 */
const terms: Record<string, string> = {};

for (const section of sections) {
  for (const block of section.blocks) {
    if (block.type === 'text' && block.term) terms[block.term] = block.paragraphs[0];
  }
}

/*
 * Оглавление: глава на раздел, шаг на подзаголовок внутри него. Названия
 * берутся из самих глав — так велит спека макета, — а якоря CaseSection
 * считает от тех же заголовков той же slugify, поэтому они совпадают.
 */
const toc = sections.map((section) => ({
  id: slugify(section.title),
  title: section.title,
  steps: section.blocks
    .filter((block) => block.type === 'heading')
    .map((block) => ({ id: slugify(block.text), title: block.text })),
}));
---

<BaseLayout title={`${title} — ${profile.name}`} description={description}>
  <CaseHero entry={entry} />

  <div class="case-body">
    {
      sections.map((section) => (
        <>
          {/* Разделители лежат вне контейнера: в макете линия идёт
              от края до края окна, а не по ширине контента. */}
          <Divider />
          <CaseSection
            title={section.title}
            titleLines={section.titleLines}
            blocks={section.blocks}
            terms={terms}
          />
        </>
      ))
    }
  </div>

  <CaseToc items={toc} />
</BaseLayout>

<style>
  /* Вертикальный ритм макета: между разделами и разделителями ровно 160px,
     поэтому разделитель здесь — такой же элемент сетки, как раздел. */
  .case-body {
    display: grid;
    gap: var(--space-section);
    padding-bottom: var(--space-section);
  }
</style>
