---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseHero from '../../components/CaseHero.astro';
import CaseSection from '../../components/CaseSection.astro';
import CaseToc from '../../components/CaseToc.astro';
import Divider from '../../components/Divider.astro';
import { profile } from '../../data/profile.ts';
import { ui } from '../../data/ui.ts';
import { slugify } from '../../utils/slug.ts';

/*
 * Страница кейса собирается только у тех кейсов, где уже описаны разделы.
 * Заготовка без содержимого дала бы пустую страницу — и в sitemap тоже.
 */
export async function getStaticPaths() {
  const cases = await getCollection('cases');

  return cases
    .filter((entry) => entry.data.sections.length > 0)
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, sections } = entry.data;

/* Отдельного поля под описание в макете нет — берём первый абзац кейса. */
const description = sections
  .flatMap((section) => section.blocks)
  .find((block) => block.type === 'text')?.paragraphs[0];

/*
 * Словарь терминов: блок «Терминологии» с полем `term` даёт определение,
 * а разметка `[[ключ|слово]]` в тексте кейса на него ссылается. Так текст
 * определения хранится в одном месте — там, где его читают целиком.
 */
const terms: Record<string, string> = {};

for (const section of sections) {
  for (const block of section.blocks) {
    if (block.type === 'text' && block.term) terms[block.term] = block.paragraphs[0];
  }
}

/*
 * Якорь раздела. Обычно это просто slug заголовка, но заголовки повторяются:
 * во втором кейсе «Решения» стоит у двух разделов, а id на странице обязан
 * быть один. Поэтому повтор получает номер, и этот же id уезжает и в раздел,
 * и в оглавление — чтобы они не разошлись.
 */
const usedIds = new Set<string>();

function sectionId(title: string): string {
  const base = slugify(title);
  let id = base;

  for (let n = 2; usedIds.has(id); n += 1) id = `${base}-${n}`;

  usedIds.add(id);
  return id;
}

const sectionIds = sections.map((section) => (section.title ? sectionId(section.title) : undefined));

/*
 * Оглавление: глава на раздел, шаг на подзаголовок внутри него. Названия
 * берутся из самих глав — так велит спека макета, — а якоря шагов CaseSection
 * считает той же slugify от тех же заголовков, поэтому они совпадают.
 *
 * Раздел без заголовка — продолжение предыдущего (в макете так набран второй
 * шаг «Решений»): своей главы у него нет, его шаги дописываются в главу выше.
 */
const toc: { id: string; title: string; steps: { id: string; title: string }[] }[] = [];

sections.forEach((section, index) => {
  const steps = section.blocks
    .filter((block) => block.type === 'heading')
    .map((block) => ({ id: slugify(block.text), title: block.text }));

  const id = sectionIds[index];

  if (section.title && id) {
    toc.push({ id, title: section.title, steps });
  } else {
    toc.at(-1)?.steps.push(...steps);
  }
});
---

<BaseLayout title={`${title} — ${profile.name}`} description={description}>
  <CaseHero entry={entry} />

  <div class="case-body">
    {
      sections.map((section, index) => (
        <>
          {/* Разделители лежат вне контейнера: в макете линия идёт
              от края до края окна, а не по ширине контента.

              Раздел-продолжение отбивается от предыдущего только отступом:
              линия читалась бы как граница главы, а это тот же раздел —
              шаги «Решений» внутри одной главы. Расстояние при этом такое
              же, как между шагами в первом кейсе, — 160. */}
          {section.title && <Divider />}
          <CaseSection
            id={sectionIds[index]}
            title={section.title}
            titleLines={section.titleLines}
            blocks={section.blocks}
            terms={terms}
            backLink={
              index === sections.length - 1
                ? { href: '/', label: ui.actions.backHome }
                : undefined
            }
          />
        </>
      ))
    }
  </div>

  <CaseToc items={toc} />
</BaseLayout>

<style>
  /* Вертикальный ритм макета: между разделами и разделителями ровно 160px,
     поэтому разделитель здесь — такой же элемент сетки, как раздел. */
  .case-body {
    display: grid;
    gap: var(--space-section);
    padding-bottom: var(--space-section);
  }
</style>
